{
  "name": "agents-handoff",
  "version": "2.0.5",
  "description": "Write, verify, and hand off complete AI working sessions across any harness (Claude Code, Codex, DeepSeek Harness, plain JSONL or text logs). Cross-harness session capture with sha256 provenance and verified continuation.",
  "type": "module",
  "main": "tools/handoff.mjs",
  "bin": {
    "agents-handoff": "./install/install.mjs",
    "handoff": "./tools/handoff.mjs"
  },
  "files": [
    "install/",
    "tools/",
    "templates/",
    "refs/",
    "schemas/",
    "docs/",
    "tests/",
    "CHANGELOG.md",
    "README.md",
    "LICENSE",
    "SKILL.md",
    "skill.json",
    "capability-registry.json",
    "permission-policy.json",
    "handoff.config.schema.json",
    "handoff.config.example.json"
  ],
  "scripts": {
    "test": "node tools/handoff.test.mjs",
    "check:docs": "node .github/scripts/check-docs.mjs",
    "check:session-index": "node .github/scripts/build-sessions-index.mjs --check",
    "prepublishOnly": "node tools/handoff.test.mjs && node .github/scripts/check-docs.mjs && node .github/scripts/build-sessions-index.mjs --check",
    "verify": "node tools/handoff.mjs verify",
    "build": "node tools/handoff.mjs build"
  },
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "ai",
    "agent",
    "handoff",
    "session",
    "continuation",
    "cross-harness",
    "provenance",
    "claude-code",
    "codex",
    "installer",
    "npx",
    "skill"
  ],
  "author": "Alot1z",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Alot1z/agent-handoff.git"
  },
  "bugs": {
    "url": "https://github.com/Alot1z/agent-handoff/issues"
  },
  "homepage": "https://alot1z.github.io/agent-handoff/",
  "engines": {
    "node": ">=18.0.0"
  },
  "dependencies": {}
}

{
  "name": "agent-handoff",
  "version": "2.0.1",
  "description": "Write, verify, and hand off complete AI working sessions across any harness (Claude Code, Codex, DeepSeek Harness, plain JSONL or text logs). Cross-harness session capture with sha256 provenance and verified continuation.",
  "type": "module",
  "main": "tools/handoff.mjs",
  "bin": {
    "agent-handoff": "./tools/handoff.mjs"
  },
  "files": [
    "tools/",
    "templates/",
    "refs/",
    "docs/",
    "CHANGELOG.md",
    "SKILL.md"
  ],
  "scripts": {
    "test": "node tools/handoff.test.mjs",
    "check:docs": "node .github/scripts/check-docs.mjs",
    "verify": "node tools/handoff.mjs verify",
    "build": "node tools/handoff.mjs build"
  },
  "keywords": [
    "ai",
    "agent",
    "handoff",
    "session",
    "continuation",
    "cross-harness",
    "provenance",
    "claude-code",
    "codex"
  ],
  "author": "Alot1z",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Alot1z/agent-handoff.git"
  },
  "bugs": {
    "url": "https://github.com/Alot1z/agent-handoff/issues"
  },
  "homepage": "https://alot1z.github.io/agent-handoff/",
  "engines": {
    "node": ">=18.0.0"
  },
  "dependencies": {}
}

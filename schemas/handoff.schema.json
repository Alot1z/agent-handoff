{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Agent-Handoff",
  "description": "Portable execution state for agent-handoff — canonical handoff schema v1.0",
  "type": "object",
  "required": [
    "schema_version",
    "handoff_id",
    "mission_id",
    "task_id",
    "created_at",
    "updated_at",
    "source",
    "state",
    "next_action"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "pattern": "^1\\.0$",
      "description": "Schema version for compatibility checking"
    },
    "handoff_id": {
      "type": "string",
      "minLength": 1,
      "description": "Unique handoff identifier"
    },
    "mission_id": {
      "type": "string",
      "minLength": 1,
      "description": "Mission this handoff belongs to"
    },
    "task_id": {
      "type": "string",
      "minLength": 1,
      "description": "Task this handoff is for"
    },
    "created_at": {
      "type": "string",
      "format": "date-time",
      "description": "ISO 8601 creation timestamp"
    },
    "updated_at": {
      "type": "string",
      "format": "date-time",
      "description": "ISO 8601 last update timestamp"
    },
    "source": {
      "type": "object",
      "required": ["agent", "runtime", "version"],
      "properties": {
        "agent": { "type": "string" },
        "runtime": { "type": "string" },
        "version": { "type": "string" }
      },
      "description": "Source agent/runtime that created this handoff"
    },
    "target": {
      "type": "object",
      "properties": {
        "agent": { "type": "string" },
        "runtime": { "type": "string" },
        "version": { "type": "string" }
      },
      "description": "Target agent/runtime for resume"
    },
    "input_contract": {
      "type": "object",
      "description": "Input contract for the session that produced this handoff"
    },
    "state": {
      "type": "object",
      "required": ["status", "current_action"],
      "properties": {
        "status": {
          "type": "string",
          "enum": ["PENDING", "ACTIVE", "COMPLETED", "SATISFIED", "NOT_APPLICABLE", "BLOCKED", "FAILED", "IN_PROGRESS"]
        },
        "current_action": { "type": "string" },
        "completed_work": {
          "type": "array",
          "items": { "type": "string" }
        },
        "pending_work": {
          "type": "array",
          "items": { "type": "string" }
        },
        "blockers": {
          "type": "array",
          "items": { "type": "object" }
        },
        "unknowns": {
          "type": "array",
          "items": { "type": "object" }
        },
        "assumptions": {
          "type": "array",
          "items": { "type": "object" }
        }
      }
    },
    "execution": {
      "type": "object",
      "properties": {
        "last_operation": { "type": "string" },
        "result": { "type": "string" },
        "exit_code": { "type": ["integer", "null"] },
        "changed_files": {
          "type": "array",
          "items": { "type": "string" }
        }
      }
    },
    "capabilities": {
      "type": "object",
      "properties": {
        "required": {
          "type": "array",
          "items": { "$ref": "#/definitions/capability" }
        },
        "selected": {
          "type": "array",
          "items": { "$ref": "#/definitions/capability" }
        },
        "unavailable": {
          "type": "array",
          "items": { "$ref": "#/definitions/capability" }
        }
      }
    },
    "permissions": {
      "type": "object",
      "properties": {
        "current": {
          "type": "array",
          "items": { "type": "string" }
        },
        "approvals": {
          "type": "array",
          "items": { "type": "object" }
        }
      }
    },
    "checkpoint": {
      "type": "object",
      "required": ["checkpoint_id", "state_hash", "created_at"],
      "properties": {
        "checkpoint_id": { "type": "string" },
        "predecessor_checkpoint": { "type": "string" },
        "state_summary": { "type": "string" },
        "state_hash": { "type": "string" },
        "created_at": { "type": "string", "format": "date-time" },
        "completed_work": { "type": "array", "items": { "type": "string" } },
        "verified_work": { "type": "array", "items": { "type": "string" } },
        "pending_work": { "type": "array", "items": { "type": "string" } },
        "artifact_manifest": { "type": "array", "items": { "type": "object" } },
        "environment_fingerprint": { "type": "string" },
        "capability_requirements": { "type": "array", "items": { "type": "string" } },
        "permission_state": { "type": "array", "items": { "type": "string" } },
        "verification_results": { "type": "array", "items": { "type": "object" } },
        "next_action": { "type": "string" },
        "recovery_notes": { "type": "string" }
      }
    },
    "artifacts": {
      "type": "object",
      "properties": {
        "manifest": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["path", "purpose"],
            "properties": {
              "path": { "type": "string" },
              "purpose": { "type": "string" },
              "canonical": { "type": "boolean" },
              "generated": { "type": "boolean" },
              "source_of_truth": { "type": "string" }
            }
          }
        }
      }
    },
    "evidence": {
      "type": "object",
      "properties": {
        "verified": {
          "type": "array",
          "items": { "type": "object" }
        },
        "observed": {
          "type": "array",
          "items": { "type": "object" }
        },
        "unresolved": {
          "type": "array",
          "items": { "type": "object" }
        }
      }
    },
    "decisions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["decision", "reason"],
        "properties": {
          "decision": { "type": "string" },
          "reason": { "type": "string" },
          "timestamp": { "type": "string" }
        }
      }
    },
    "errors": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["error", "timestamp"],
        "properties": {
          "error": { "type": "string" },
          "timestamp": { "type": "string" },
          "resolved": { "type": "boolean" }
        }
      }
    },
    "next_action": {
      "type": "object",
      "required": ["objective"],
      "properties": {
        "objective": { "type": "string" },
        "reason": { "type": "string" },
        "preconditions": { "type": "array", "items": { "type": "string" } },
        "required_capabilities": { "type": "array", "items": { "type": "string" } },
        "required_permissions": { "type": "array", "items": { "type": "string" } },
        "verification": { "type": "array", "items": { "type": "string" } }
      }
    }
  },
  "definitions": {
    "capability": {
      "type": "object",
      "required": ["id", "name", "type", "provider"],
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "type": { "type": "string" },
        "provider": { "type": "string" },
        "purpose": { "type": "string" },
        "inputs": { "type": "array", "items": { "type": "string" } },
        "outputs": { "type": "array", "items": { "type": "string" } },
        "prerequisites": { "type": "array", "items": { "type": "string" } },
        "dependencies": { "type": "array", "items": { "type": "string" } },
        "supports": { "type": "array", "items": { "type": "string" } },
        "does_not_support": { "type": "array", "items": { "type": "string" } },
        "side_effects": { "type": "array", "items": { "type": "string" } },
        "risk_class": { "type": "string", "enum": ["R0", "R1", "R2", "R3", "R4"] },
        "permission_level": { "type": "string" },
        "scope": { "type": "array", "items": { "type": "string" } },
        "targets": { "type": "array", "items": { "type": "string" } },
        "reversibility": { "type": "string" },
        "availability": { "type": "string", "enum": ["available", "unavailable", "degraded"] },
        "health": { "type": "string", "enum": ["healthy", "unhealthy", "unknown"] },
        "version": { "type": "string" },
        "platform": { "type": "array", "items": { "type": "string" } },
        "architecture": { "type": "array", "items": { "type": "string" } },
        "cost": { "type": "string" },
        "latency": { "type": "string" },
        "failure_modes": { "type": "array", "items": { "type": "string" } },
        "verification_method": { "type": "string" },
        "provenance": { "type": "string" },
        "trust": { "type": "string", "enum": ["BUILT_IN", "PROJECT", "LOCAL", "USER_AUTHORIZED_EXTERNAL", "EXTERNAL", "UNTRUSTED"] }
      }
    }
  },
  "additionalProperties": false
}
